{
  "manifest_version": 3,
  "name": "Phishnet",
  "version": "1.0",
  "description": "ML + HTML based phishing detection",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/phishnet_icon.jpg",
        "assets/alert.mp3"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
